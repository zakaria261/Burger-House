# Connexion applicative au pool Postgres (serveur uniquement)
DATABASE_URL=
# Connexion directe, réservée au script de migration
DIRECT_DATABASE_URL=
# Authentification Neon, configurée pour ce restaurant
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
# Adresses autorisées, séparées par des virgules
ADMIN_EMAILS=
# Notifications Web Push : clés générées une fois (jamais exposer la clé privée)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://burger-house-one-tau.vercel.app
# À renseigner quand Douwi communiquera son adresse, également autorisée dans ADMIN_EMAILS.
PUSH_RECIPIENT_EMAIL=
